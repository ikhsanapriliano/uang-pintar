model AIChatTranscription {
  id        String        @id @default(uuid())
  sessionId String
  text      String
  seconds   Float
  cost      Float
  createdAt DateTime      @default(now()) @map("created_at")
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_chat_transcriptions")
}
